rules_version = '2';

// NUTrade - Firestore Security Rules (proposed)
// Project: nutrade-a25c7  -- SHARED by the Blazor WASM admin console (web)
// and the student mobile app. Both use the Firebase *client* SDK, so both are
// subject to these rules. Cloud Functions use the Admin SDK and BYPASS rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    // Claim-first: a custom claim costs 0 reads and short-circuits the get()s.
    // The Firestore fallbacks mirror verifyAdminCaller() in functions/index.js
    // so web, app and functions all agree on who is an admin.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function affected() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Listing fields only moderation / payment (admin or Admin SDK) may set.
    function modifiesListingSensitiveFields() {
      return affected().hasAny([
        'sellerUid',
        'status',
        'isVisible',
        'approvedAt',
        'approvedBy',
        'rejectedAt',
        'rejectedBy',
        'rejectionReason',
        'publishedAt',
        'auctionEndsAt',
        'paidPackage'
      ]);
    }

    // User fields only an admin may set. Without this, any app user could
    // write role:'admin' to their own doc and become an admin.
    function modifiesUserPrivilegedFields() {
      return affected().hasAny([
        'role',
        'verificationStatus',
        'verifiedAt',
        'rejectionReason',
        'canPost',
        'canBid',
        'canChat',
        'isSuspended',
        'isBanned'
      ]);
    }

    // ---------------------------------------------------------------
    // LISTINGS
    // ---------------------------------------------------------------
    match /listings/{listingId} {
      // Authenticated read only: closes anonymous enumeration of drafts,
      // rejected listings, rejection reasons and seller UIDs.
      // Unfiltered collection listens still work (admin console relies on one).
      // Stricter variant, if the app filters server-side with
      // .where('status','==','active'):
      //   allow read: if isAdmin()
      //     || (isAuthenticated() && resource.data.status == 'active')
      //     || isOwner(resource.data.sellerUid);
      allow read: if isAuthenticated();

      // App-side creation: seller is pinned to the caller and cannot
      // self-publish or pre-set moderation / payment fields.
      allow create: if isAuthenticated()
        && request.resource.data.sellerUid == request.auth.uid
        && request.resource.data.status in ['pending_approval', 'pending_payment', 'draft']
        && !request.resource.data.keys().hasAny([
             'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy', 'paidPackage'
           ]);

      // Owner may edit their own listing's own content; moderation belongs to
      // admins (web console writes these directly) and to Cloud Functions.
      allow update: if isAdmin()
        || (isOwner(resource.data.sellerUid) && !modifiesListingSensitiveFields());

      allow delete: if isAdmin() || isOwner(resource.data.sellerUid);

      // BIDS -- append-only audit trail. Immutable once placed.
      match /bids/{bidId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.bidderUid == request.auth.uid
          && get(/databases/$(database)/documents/listings/$(listingId)).data.status == 'active';
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------------
    // USERS
    // ---------------------------------------------------------------
    match /users/{userId} {
      // Admin console listens to the whole collection; students only need
      // their own profile. Tighten to this once the app stops reading
      // other users' docs directly:
      //   allow read: if isAdmin() || isOwner(userId);
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.verificationStatus == 'pending';

      // Self-service profile edits, minus anything that grants privileges.
      allow update: if isAdmin()
        || (isOwner(userId) && !modifiesUserPrivilegedFields());

      // Account removal is an admin/back-office action only.
      allow delete: if isAdmin();
    }

    // Admin whitelist. Read/written only by the Admin SDK in Cloud Functions;
    // no client may enumerate or grant admin rights.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // MONEY -- server-authored only (createQrPayment / paymongoWebhook)
    // ---------------------------------------------------------------
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // NOTIFICATIONS
    // ---------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      // Recipient may only flip the read flag.
      allow update: if isAdmin()
        || (isOwner(resource.data.userId) && affected().hasOnly(['isRead', 'readAt']));
      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // ---------------------------------------------------------------
    // ADMIN 2FA CODES -- one admin must not be able to read another's code.
    // NOTE: written during admin sign-in, so isAdmin() must already resolve
    // at that point (custom claim, admins/{uid} doc, or users/{uid}.role).
    // ---------------------------------------------------------------
    match /admin_security_codes/{codeId} {
      allow read, write: if isAdmin() && request.auth.uid == codeId;
    }

    // Everything not matched above is denied by default -- including
    // products/, items/, posts/, marketplace/ (previously world-writable)
    // and any chat collection the app may use. Add an explicit,
    // owner-scoped block before relying on those from the app.
  }
}
