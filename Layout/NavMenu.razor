@inject IFirebaseAuthService AuthService
@inject IFirestoreService FirestoreService
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="nu-sidebar-brand">
    <div class="nu-brand-title">
        <span style="color: var(--nu-gold-primary); font-weight: 800; font-size: 1.25rem;">NU</span><span style="color: #FFFFFF; font-weight: 800; font-size: 1.25rem;">Trade</span>
        <span class="nu-brand-badge">ADMIN</span>
    </div>
</div>

<div class="nu-nav-section">Main Modules</div>

<nav class="nu-nav">
    <NavLink class="nu-nav-link" href="admin/dashboard" Match="NavLinkMatch.All">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="7" height="9" x="3" y="3" rx="1"/>
            <rect width="7" height="5" x="14" y="3" rx="1"/>
            <rect width="7" height="9" x="14" y="12" rx="1"/>
            <rect width="7" height="5" x="3" y="16" rx="1"/>
        </svg>
        <span style="flex: 1;">Master Dashboard</span>
    </NavLink>

    <NavLink class="nu-nav-link" href="admin/verifications">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <polyline points="16 11 18 13 22 9"/>
        </svg>
        <span style="flex: 1;">Email Verifications</span>
        @if (FirestoreService.PendingVerifications.Count > 0)
        {
            <span class="nu-nav-count accent">
                @FirestoreService.PendingVerifications.Count
            </span>
        }
    </NavLink>

    <NavLink class="nu-nav-link" href="admin/listings">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"/>
            <polyline points="2 17 12 22 22 17"/>
            <polyline points="2 12 12 17 22 12"/>
        </svg>
        <span style="flex: 1;">Listing Moderation</span>
        @if (FirestoreService.ActiveListings.Count > 0)
        {
            <span class="nu-nav-count">
                @FirestoreService.ActiveListings.Count
            </span>
        }
    </NavLink>
</nav>

<div class="nu-sidebar-footer">
    <div class="nu-sidebar-user">
        <img src="@(AuthService.CurrentUser?.PhotoUrl ?? "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100")"
             alt="Admin Avatar"
             class="nu-sidebar-avatar" />
        <div style="flex: 1; min-width: 0;">
            <div class="nu-sidebar-user-name">
                @(AuthService.CurrentUser?.DisplayName ?? "NU Lipa Admin")
            </div>
            <div class="nu-sidebar-user-role">
                <span class="pulse-dot" style="background-color: var(--nu-gold-primary); width: 6px; height: 6px;"></span>
                <span>Verified Admin</span>
            </div>
        </div>
    </div>
    <button type="button" @onclick="HandleLogout" class="btn-nu-outline" style="width: 100%; font-size: 0.8rem; padding: 0.45rem 0.75rem; border-color: rgba(255, 255, 255, 0.18); color: #CBD5E1;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
        <span>Sign Out</span>
    </button>
</div>

@code {
    protected override void OnInitialized()
    {
        FirestoreService.OnVerificationsUpdated += StateHasChanged;
        FirestoreService.OnListingsUpdated += StateHasChanged;
        AuthService.OnAuthStateChanged += StateHasChanged;
    }

    private async Task HandleLogout()
    {
        await AuthService.SignOutAsync();
        NavigationManager.NavigateTo("login");
    }

    public void Dispose()
    {
        FirestoreService.OnVerificationsUpdated -= StateHasChanged;
        FirestoreService.OnListingsUpdated -= StateHasChanged;
        AuthService.OnAuthStateChanged -= StateHasChanged;
    }
}
