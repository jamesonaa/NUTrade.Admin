@page "/admin/verifications"
@inject IFirestoreService FirestoreService
@inject IFirebaseAuthService AuthService
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@implements IDisposable

<PageTitle>Email Verification Queue | NUTrade Admin</PageTitle>

<div style="display: flex; flex-direction: column; gap: 1.25rem;">

    <div style="background: #EFF6FF; border: 1px solid #BFDBFE; border-left: 4px solid var(--nu-navy-primary); border-radius: 8px; padding: 1.25rem; margin-bottom: 1rem;">
        <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--nu-navy-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <div>
                <h4 style="margin: 0 0 0.35rem; color: var(--nu-navy-primary); font-weight: 700; font-size: 0.98rem;">Automated OTP Verification Active</h4>
                <p style="margin: 0; color: #1E3A8A; font-size: 0.85rem; line-height: 1.5;">
                    Manual admin approval for new student accounts is disabled. Student registration is now fully automated via OTP verification in the mobile app. You can inspect registered users in <a href="admin/users" style="color: var(--nu-navy-primary); font-weight: 700; text-decoration: underline;">Users Management</a>. This page is read-only; verification is revoked or restored from Users Management through the setUserVerification Cloud Function.
                </p>
            </div>
        </div>
    </div>

    <div class="nu-card">
        @{
            var rows = FilteredVerifications.ToList();
            var pageRows = _page.Slice(rows);
        }
        <div class="vu-toolbar">
            <div class="vu-search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text"
                       class="nu-input"
                       placeholder="Search by name, email, or UID..."
                       @bind="_searchFilter"
                       @bind:event="oninput"
                       @bind:after="_page.Reset" />
            </div>
            <div class="vu-sort-hint">
                @if (!string.IsNullOrWhiteSpace(_searchFilter))
                {
                    <span>@rows.Count result@(rows.Count == 1 ? "" : "s")</span>
                    <span style="opacity: 0.4;">·</span>
                }
                <select class="nu-select" @bind="_sortOrder" @bind:after="_page.Reset" aria-label="Sort by registration time">
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                </select>
            </div>
        </div>

        @if (rows.Count > 0)
        {
            <div class="vu-list">
                @foreach (var student in pageRows)
                {
                    var submitted = student.SubmittedAt ?? student.CreatedAt;
                    <div class="vu-row">
                        <div class="vu-student">
                            <div class="vu-avatar">
                                @(student.DisplayName.Length > 0 ? student.DisplayName[0].ToString().ToUpper() : "?")
                            </div>
                            <div style="min-width: 0;">
                                <div class="vu-name">@student.DisplayName</div>
                                <div class="vu-uid">@TruncateUid(student.Uid)</div>
                            </div>
                        </div>

                        <div class="vu-email" title="@student.Email">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="20" height="16" x="2" y="4" rx="2"/>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                            </svg>
                            <span style="overflow: hidden; text-overflow: ellipsis;">@student.Email</span>
                        </div>

                        <div class="vu-time">
                            <div class="vu-time-rel">@FormatRelative(submitted)</div>
                            <div class="vu-time-abs">@(submitted.HasValue ? submitted.Value.ToLocalTime().ToString("MMM dd, yyyy · hh:mm tt") : "Date not recorded")</div>
                        </div>

                        <div class="vu-actions">
                            <StatusBadge Status="@student.VerificationStatus" Kind="verification" />
                        </div>
                    </div>
                }
            </div>
            <Pager State="_page" TotalCount="rows.Count" Changed="StateHasChanged" />
        }
        else
        {
            <div class="vu-empty">
                <div class="vu-empty-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                </div>
                @if (string.IsNullOrWhiteSpace(_searchFilter))
                {
                    <h3>Queue is clear</h3>
                    <p>All pending personal emails have been reviewed.</p>
                }
                else
                {
                    <h3>No matches</h3>
                    <p>Nothing found for “@_searchFilter”.</p>
                }
            </div>
        }
    </div>
</div>

@code {
    private string _searchFilter = string.Empty;
    private string _sortOrder = "newest";
    private readonly PageState _page = new();

    private IEnumerable<UserProfile> FilteredVerifications
    {
        get
        {
            var query = FirestoreService.PendingVerifications.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchFilter))
            {
                query = query.Where(u =>
                    u.DisplayName.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Email.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) ||
                    u.Uid.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase));
            }

            Func<UserProfile, DateTime> submitted = u => u.SubmittedAt ?? u.CreatedAt ?? DateTime.MinValue;
            return _sortOrder == "oldest" ? query.OrderBy(submitted) : query.OrderByDescending(submitted);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (!AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("login");
            return;
        }

        if (!AuthService.IsSecurityVerified)
        {
            NavigationManager.NavigateTo("security-verification");
            return;
        }

        FirestoreService.OnVerificationsUpdated += HandleUpdate;
        await FirestoreService.InitializeSubscriptionsAsync();
    }

    private void HandleUpdate() => InvokeAsync(StateHasChanged);

    private static string TruncateUid(string uid)
    {
        if (string.IsNullOrEmpty(uid)) return "—";
        return uid.Length <= 16 ? uid : $"{uid[..16]}…";
    }

    private static string FormatRelative(DateTime? value)
    {
        if (!value.HasValue) return "—";
        var dt = value.Value;
        var local = dt.Kind == DateTimeKind.Unspecified
            ? DateTime.SpecifyKind(dt, DateTimeKind.Utc).ToLocalTime()
            : dt.ToLocalTime();
        var span = DateTime.Now - local;

        if (span.TotalSeconds < 45) return "Just now";
        if (span.TotalMinutes < 60) return $"{Math.Max(1, (int)span.TotalMinutes)}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return local.ToString("MMM dd");
    }

    public void Dispose()
    {
        FirestoreService.OnVerificationsUpdated -= HandleUpdate;
    }
}
