@page "/login"
@page "/"
@inject IFirebaseAuthService AuthService
@inject NavigationManager NavigationManager
@inject ToastService ToastService

<PageTitle>Admin Sign-In | NUTrade Portal</PageTitle>

<div class="login-card nu-card">
    <div class="login-brand">
        <div class="login-logo-container">
            <img src="images/nutradelonglogo.png" alt="NUTrade Logo" class="login-logo-img" />
        </div>
        <div class="login-badge-container">
            <span class="nu-brand-badge login-admin-badge">ADMIN</span>
        </div>
        <p class="login-subtitle">Marketplace Administration Portal</p>
    </div>

    <div class="login-notice">
        <div class="login-notice-title">Restricted Access (RBAC)</div>
        <div class="login-notice-body">Admin privileges and verified institutional credentials required.</div>
    </div>

    @if (_isEmailUnverified)
    {
        <div class="login-notice" style="background: #FFFBEB; border-left: 3px solid var(--nu-gold-primary); margin-bottom: 1.25rem; padding: 0.85rem 1rem;">
            <div class="login-notice-title" style="color: var(--nu-gold-dark); font-weight: 800; font-size: 0.78rem;">EMAIL VERIFICATION REQUIRED</div>
            <div class="login-notice-body" style="color: #78350F; margin-top: 0.35rem; margin-bottom: 0.75rem; font-size: 0.82rem; line-height: 1.45;">
                Your admin account email (<strong>@_unverifiedEmail</strong>) is not yet verified in Firebase Authentication. Please check your inbox and verify your email to unlock access.
            </div>

            <button type="button"
                    class="btn-nu-gold"
                    style="font-size: 0.8rem; padding: 0.45rem 0.85rem; width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.4rem;"
                    @onclick="ResendVerification"
                    disabled="@_isResending">
                @if (_isResending)
                {
                    <span class="pulse-dot" style="background-color: var(--nu-navy-dark);"></span>
                    <span>Sending Verification Email...</span>
                }
                else
                {
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 2 2h9"/>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                        <path d="M19 16v6"/>
                        <path d="M16 19h6"/>
                    </svg>
                    <span>Resend Verification Email</span>
                }
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_authErrorMessage) && !_isEmailUnverified)
    {
        <div class="login-error">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span>@_authErrorMessage</span>
        </div>
    }

    <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />

        <div class="nu-input-group">
            <label class="nu-label" for="admin-email">Admin Email</label>
            <InputText id="admin-email"
                       class="nu-input"
                       placeholder="Enter your administrative email address"
                       @bind-Value="_loginModel.Email"
                       disabled="@_isProcessing" />
            <ValidationMessage For="@(() => _loginModel.Email)" class="validation-message" style="font-size: 0.78rem; margin-top: 0.35rem; display: block;" />
        </div>

        <div class="nu-input-group">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.4rem;">
                <label class="nu-label" for="admin-password" style="margin-bottom: 0;">Password</label>
                <span style="font-size: 0.72rem; color: var(--nu-text-muted);">Firebase Auth</span>
            </div>
            <InputText id="admin-password"
                       type="password"
                       class="nu-input"
                       placeholder="Enter your password"
                       @bind-Value="_loginModel.Password"
                       disabled="@_isProcessing" />
            <ValidationMessage For="@(() => _loginModel.Password)" class="validation-message" style="font-size: 0.78rem; margin-top: 0.35rem; display: block;" />
        </div>

        <div class="login-row">
            <label class="login-remember">
                <input type="checkbox" @bind="_loginModel.RememberMe" style="accent-color: var(--nu-navy-primary);" />
                <span>Remember admin session</span>
            </label>
            <span class="badge-pill badge-pill-gold">TLS Secured</span>
        </div>

        <button type="submit"
                class="btn-nu-gold"
                style="width: 100%; padding: 0.75rem; font-size: 0.95rem;"
                disabled="@_isProcessing">
            @if (_isProcessing)
            {
                <span class="pulse-dot" style="background-color: var(--nu-navy-dark);"></span>
                <span>Verifying Credentials...</span>
            }
            else
            {
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                    <polyline points="10 17 15 12 10 7"/>
                    <line x1="15" y1="12" x2="3" y2="12"/>
                </svg>
                <span>Sign In to Admin Console</span>
            }
        </button>
    </EditForm>
</div>

@code {
    private readonly LoginRequest _loginModel = new()
    {
        Email = string.Empty,
        Password = string.Empty
    };

    private bool _isProcessing = false;
    private bool _isResending = false;
    private bool _isEmailUnverified = false;
    private string? _unverifiedEmail;
    private string? _authErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();

        if (AuthService.IsSecurityVerified)
        {
            NavigationManager.NavigateTo("admin/dashboard");
        }
        else if (AuthService.CurrentUser != null && AuthService.CurrentUser.EmailVerified)
        {
            NavigationManager.NavigateTo("security-verification");
        }
    }

    private async Task ResendVerification()
    {
        _isResending = true;
        await AuthService.ResendEmailVerificationAsync(_unverifiedEmail);
        _isResending = false;
    }

    private async Task HandleLogin()
    {
        _isProcessing = true;
        _authErrorMessage = null;
        _isEmailUnverified = false;

        try
        {
            // Execute Firebase Authentication and emailVerification & RBAC check
            var result = await AuthService.SignInAsync(_loginModel.Email, _loginModel.Password);

            if (result.IsEmailUnverified)
            {
                _isEmailUnverified = true;
                _unverifiedEmail = result.UnverifiedEmail ?? _loginModel.Email;
                _authErrorMessage = result.ErrorMessage;
            }
            else if (result.Success && result.RequiresSecurityVerification)
            {
                // Route to /security-verification step before granting dashboard access
                NavigationManager.NavigateTo("security-verification");
            }
            else
            {
                _authErrorMessage = result.ErrorMessage ?? "Unauthorized access: Admin privileges and verified email required.";
            }
        }
        catch (Exception ex)
        {
            _authErrorMessage = $"Authentication error: {ex.Message}";
            ToastService.ShowError(_authErrorMessage, "System Error");
        }
        finally
        {
            _isProcessing = false;
        }
    }
}
