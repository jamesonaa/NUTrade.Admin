@page "/forgot-password"
@inject IFirebaseAuthService AuthService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Reset Password | NUTrade Portal</PageTitle>

<div class="login-card nu-card">
    <div class="login-brand">
        <div class="login-logo-container">
            <img src="images/nutradelonglogo.png" alt="NUTrade Logo" class="login-logo-img" />
        </div>
        <div class="login-badge-container">
            <span class="nu-brand-badge login-admin-badge">ADMIN</span>
        </div>
        <p class="login-subtitle">Reset your password</p>
    </div>

    @if (_step == Step.Done)
    {
        <div class="login-notice" style="border-left-color: var(--nu-success); background: var(--nu-success-bg);">
            <div class="login-notice-title" style="color: var(--nu-success);">Password updated</div>
            <div class="login-notice-body">
                Your password has been changed and every other signed-in device has been signed out. Sign in with your new password.
            </div>
        </div>
        <button type="button" class="btn-nu-gold" style="width: 100%; padding: 0.75rem;" @onclick='() => NavigationManager.NavigateTo("login")'>
            Back to sign in
        </button>
    }
    else
    {
        <div class="login-notice">
            <div class="login-notice-title">Step @((int)_step + 1) of 3</div>
            <div class="login-notice-body">
                @switch (_step)
                {
                    case Step.Email:
                        <span>Enter your account email. We will send a six-digit code to that address.</span>
                        break;
                    case Step.Code:
                        <span>
                            Enter the six-digit code sent to <strong>@(_sentTo ?? _email)</strong>.
                            @if (_expiresInSeconds is > 0)
                            {
                                @($" It expires after {Math.Max(1, _expiresInSeconds.Value / 60)} minutes.")
                            }
                        </span>
                        break;
                    case Step.Password:
                        <span>Choose a new password for <strong>@_email</strong>.</span>
                        break;
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="login-error">
                <span>@_error</span>
            </div>
        }

        @if (_step == Step.Email)
        {
            <form @onsubmit="SendCodeAsync" @onsubmit:preventDefault>
                <div class="nu-input-group">
                    <label class="nu-label" for="reset-email">Email</label>
                    <input id="reset-email" type="email" class="nu-input" placeholder="you@example.com"
                           @bind="_email" @bind:event="oninput" disabled="@_busy" autocomplete="email" />
                </div>
                <button type="submit" class="btn-nu-gold" style="width: 100%; padding: 0.75rem;" disabled="@(_busy || !IsEmailValid)">
                    @(_busy ? "Sending code..." : "Send code")
                </button>
            </form>
        }
        else if (_step == Step.Code)
        {
            <form @onsubmit="VerifyCodeAsync" @onsubmit:preventDefault>
                <div class="nu-input-group">
                    <label class="nu-label" for="reset-code">Six-digit code</label>
                    <input id="reset-code" type="text" inputmode="numeric" maxlength="6" class="nu-input"
                           style="font-size: 1.2rem; font-weight: 800; letter-spacing: 0.25em; text-align: center;"
                           placeholder="000000" autocomplete="one-time-code"
                           @bind="_code" @bind:event="oninput" disabled="@_busy" />
                </div>
                <button type="submit" class="btn-nu-gold" style="width: 100%; padding: 0.75rem; margin-bottom: 0.75rem;" disabled="@(_busy || !IsCodeValid)">
                    @(_busy ? "Checking..." : "Verify code")
                </button>
            </form>
            <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                <button type="button" class="nu-link-button" @onclick="ChangeEmail" disabled="@_busy">Use a different email</button>
                <button type="button" class="nu-link-button" @onclick="SendCodeAsync" disabled="@(_busy || _resendSeconds > 0)">
                    @(_resendSeconds > 0 ? $"Resend in {_resendSeconds}s" : "Resend code")
                </button>
            </div>
        }
        else if (_step == Step.Password)
        {
            <form @onsubmit="CompleteAsync" @onsubmit:preventDefault>
                <div class="nu-input-group">
                    <label class="nu-label" for="new-password">New password</label>
                    <input id="new-password" type="password" class="nu-input" autocomplete="new-password"
                           @bind="_password" @bind:event="oninput" disabled="@_busy" />
                    <div class="nu-cell-sub" style="margin-top: 0.35rem;">At least @MinPasswordLength characters.</div>
                </div>
                <div class="nu-input-group">
                    <label class="nu-label" for="confirm-password">Confirm new password</label>
                    <input id="confirm-password" type="password" class="nu-input" autocomplete="new-password"
                           @bind="_confirm" @bind:event="oninput" disabled="@_busy" />
                    @if (_confirm.Length > 0 && _confirm != _password)
                    {
                        <div class="validation-message" style="font-size: 0.78rem; margin-top: 0.35rem;">Passwords do not match.</div>
                    }
                </div>
                <button type="submit" class="btn-nu-gold" style="width: 100%; padding: 0.75rem;" disabled="@(_busy || !IsPasswordValid)">
                    @(_busy ? "Updating password..." : "Set new password")
                </button>
            </form>
        }

        <div style="text-align: center; margin-top: 1rem;">
            <button type="button" class="nu-link-button" style="color: var(--nu-text-muted);" @onclick='() => NavigationManager.NavigateTo("login")' disabled="@_busy">
                Back to sign in
            </button>
        </div>
    }
</div>

@code {
    private enum Step { Email = 0, Code = 1, Password = 2, Done = 3 }

    private const int MinPasswordLength = 8;

    private Step _step = Step.Email;
    private string _email = string.Empty;
    private string? _sentTo;
    private int? _expiresInSeconds;
    private string _code = string.Empty;
    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private string? _resetToken;
    private string? _error;
    private bool _busy;
    private int _resendSeconds;
    private System.Threading.Timer? _resendTimer;

    private bool IsEmailValid => System.Text.RegularExpressions.Regex.IsMatch(_email.Trim(), @"^[^@\s]+@[^@\s]+\.[^@\s]+$");
    private bool IsCodeValid => System.Text.RegularExpressions.Regex.IsMatch(_code.Trim(), @"^\d{6}$");
    private bool IsPasswordValid => _password.Length >= MinPasswordLength && _password == _confirm;

    private async Task SendCodeAsync()
    {
        if (!IsEmailValid || _busy || (_step == Step.Code && _resendSeconds > 0)) return;
        _busy = true;
        _error = null;

        var result = await AuthService.StartPasswordResetAsync(_email);
        _busy = false;

        if (result.Success)
        {
            _sentTo = result.GetString("sentTo");
            _expiresInSeconds = result.GetInt("expiresInSeconds");
            _step = Step.Code;
            _code = string.Empty;
            StartResendCooldown(result.GetInt("resendAfterSeconds") ?? 0);
        }
        else
        {
            _error = Describe(result, "The code could not be sent.");
        }
    }

    private async Task VerifyCodeAsync()
    {
        if (!IsCodeValid || _busy) return;
        _busy = true;
        _error = null;

        var result = await AuthService.VerifyPasswordResetCodeAsync(_email, _code);
        _busy = false;

        if (result.Success)
        {
            _resetToken = result.GetString("resetToken");
            if (_resetToken == null)
            {
                _error = "NUTrade sent back something unexpected. Try again.";
                return;
            }
            _step = Step.Password;
        }
        else
        {
            _error = Describe(result, "That code is not valid.");
        }
    }

    private async Task CompleteAsync()
    {
        if (!IsPasswordValid || _busy || _resetToken == null) return;
        _busy = true;
        _error = null;

        var result = await AuthService.CompletePasswordResetAsync(_email, _resetToken, _password);
        _busy = false;

        if (result.Success)
        {
            _password = _confirm = _code = string.Empty;
            _resetToken = null;
            _step = Step.Done;
        }
        else
        {
            _error = Describe(result, "The password could not be updated.");
            // The code is spent once verified, so an expired or refused reset token needs a new code.
            if (result.ErrorCode is "permission-denied" or "deadline-exceeded" or "not-found")
            {
                _step = Step.Email;
                _code = _password = _confirm = string.Empty;
                _resetToken = null;
            }
        }
    }

    private void ChangeEmail()
    {
        _step = Step.Email;
        _code = string.Empty;
        _error = null;
    }

    private static string Describe(FunctionResult result, string fallback) => result.ErrorCode switch
    {
        "resource-exhausted" => result.ErrorMessage ?? "Too many codes requested. Wait a while and try again.",
        "unavailable" => "The server could not be reached. Check your connection and try again.",
        _ => string.IsNullOrWhiteSpace(result.ErrorMessage) ? fallback : result.ErrorMessage
    };

    private void StartResendCooldown(int seconds)
    {
        _resendSeconds = seconds;
        _resendTimer?.Dispose();
        if (seconds <= 0) return;
        _resendTimer = new System.Threading.Timer(_ =>
        {
            if (_resendSeconds > 0) _resendSeconds--;
            if (_resendSeconds <= 0) _resendTimer?.Dispose();
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);
    }

    public void Dispose() => _resendTimer?.Dispose();
}
