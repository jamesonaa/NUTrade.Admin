@page "/admin/listings"
@inject IFirestoreService FirestoreService
@inject IFirebaseAuthService AuthService
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@implements IDisposable

<PageTitle>Platform Revenue & Listing Moderation | NUTrade Admin</PageTitle>

<div style="display: flex; flex-direction: column; gap: 1.25rem;">

    <div class="page-header">
        <div>
            <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.3rem; flex-wrap: wrap;">
                <span class="badge-pill badge-pill-gold">Module B</span>
            </div>
            <h1>Platform Revenue & Listing Moderation</h1>
            <p>
                Live moderation grid for active marketplace auctions. Monitor bids, reserve prices, Priority Pin promotions, and execute administrative overrides.
            </p>
        </div>

        <div class="page-header-meta">
            <span class="badge-pill badge-pill-navy">
                <span class="pulse-dot" style="background-color: var(--nu-success);"></span>
                <span>@FirestoreService.ActiveListings.Count Live Auctions</span>
            </span>
            <span class="badge-pill badge-pill-gold">
                <span>@FirestoreService.ActiveListings.Count(l => l.IsPinned) Priority Pinned</span>
            </span>
        </div>
    </div>

    <div class="nu-card">
        <div class="dash-toolbar">
            <div class="nu-search-field" style="max-width: 340px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                </svg>
                <input type="text"
                       class="nu-input"
                       placeholder="Filter by title, category, or seller..."
                       @bind="_searchKeyword"
                       @bind:event="oninput" />
            </div>

            <div style="font-size: 0.78rem; color: var(--nu-text-muted);">
                Query: <code class="nu-mono" style="color: var(--nu-navy-primary); font-weight: 700;">listings.where('status', '==', 'active')</code>
            </div>
        </div>

        <div class="nu-table-container">
            <table class="nu-table">
                <thead>
                    <tr>
                        <th>Listing Item</th>
                        <th>Category</th>
                        <th>Seller UID</th>
                        <th>Highest Bid (₱)</th>
                        <th>Reserve Price</th>
                        <th>Auction Countdown</th>
                        <th>Priority Pin</th>
                        <th style="text-align: right;">Moderation Override</th>
                    </tr>
                </thead>
                <tbody>
                    @if (FilteredListings.Any())
                    {
                        @foreach (var listing in FilteredListings)
                        {
                            <tr>
                                <td>
                                    <div class="listing-item-cell">
                                        <img src="@listing.ImageUrl"
                                             alt="@listing.Title"
                                             class="listing-thumb" />
                                        <div style="max-width: 220px; min-width: 0;">
                                            <div style="font-family: 'Outfit', sans-serif; font-weight: 700; color: var(--nu-navy-primary); font-size: 0.88rem; line-height: 1.3;">
                                                @listing.Title
                                            </div>
                                            <div class="nu-cell-sub nu-mono">
                                                ID: @listing.Id · @listing.TotalBids bids
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-pill badge-pill-navy" style="font-size: 0.72rem;">
                                        @listing.Category
                                    </span>
                                </td>
                                <td>
                                    <div class="nu-cell-primary" style="font-size: 0.82rem;">
                                        @listing.SellerName
                                    </div>
                                    <div class="nu-cell-sub nu-mono">
                                        @listing.SellerUid
                                    </div>
                                </td>
                                <td>
                                    <div class="nu-amount" style="font-size: 1.05rem;">
                                        ₱@listing.CurrentHighestBid.ToString("N2")
                                    </div>
                                    <div class="nu-cell-sub" style="color: var(--nu-success); font-weight: 600;">
                                        Start: ₱@listing.StartingPrice.ToString("N2")
                                    </div>
                                </td>
                                <td>
                                    <div style="font-weight: 600; color: var(--nu-text-body); font-size: 0.88rem;">
                                        ₱@listing.ReservePrice.ToString("N2")
                                    </div>
                                    @if (listing.CurrentHighestBid >= listing.ReservePrice)
                                    {
                                        <span class="badge-pill badge-pill-success" style="font-size: 0.65rem;">Met</span>
                                    }
                                    else
                                    {
                                        <span class="badge-pill badge-pill-warning" style="font-size: 0.65rem;">Unmet</span>
                                    }
                                </td>
                                <td>
                                    <div style="font-weight: 700; font-size: 0.84rem; color: @(listing.RemainingTime.TotalHours < 3 ? "var(--nu-danger)" : "var(--nu-navy-primary)");">
                                        @FormatTimeSpan(listing.RemainingTime)
                                    </div>
                                    <div class="nu-cell-sub">
                                        Ends @listing.AuctionEndsAt.ToLocalTime().ToString("MMM dd, hh:mm tt")
                                    </div>
                                </td>
                                <td>
                                    @if (listing.IsPinned)
                                    {
                                        <span class="badge-pill badge-pill-gold">Pinned (₱20)</span>
                                    }
                                    else
                                    {
                                        <span style="font-size: 0.78rem; color: var(--nu-text-muted);">Standard</span>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <div class="listing-actions">
                                        <button type="button"
                                                class="btn-nu-danger"
                                                style="font-size: 0.74rem; padding: 0.4rem 0.7rem;"
                                                @onclick="() => PromptUnpublish(listing)">
                                            Unpublish
                                        </button>
                                        <button type="button"
                                                class="btn-nu-outline"
                                                style="font-size: 0.74rem; padding: 0.4rem 0.6rem;"
                                                title="Toggle Pin for testing"
                                                @onclick="() => TogglePin(listing)">
                                            @(listing.IsPinned ? "Unpin" : "Pin")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="nu-empty-state">
                                No active marketplace listings match your query.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (_selectedListingToUnpublish != null)
{
    <div class="nu-modal-backdrop" @onclick="() => _selectedListingToUnpublish = null">
        <div class="nu-modal-card" style="max-width: 500px;" @onclick:stopPropagation="true">
            <div class="nu-modal-header" style="background: var(--nu-danger-bg);">
                <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--nu-danger); margin: 0;">
                    Confirm Listing Unpublish Override
                </h3>
                <button type="button" class="btn-nu-outline" style="padding: 0.25rem 0.55rem;" @onclick="() => _selectedListingToUnpublish = null">✕</button>
            </div>

            <div class="nu-modal-body">
                <p style="font-size: 0.9rem; color: var(--nu-text-body); margin: 0 0 0.9rem;">
                    Are you sure you want to unpublish <strong>"@_selectedListingToUnpublish.Title"</strong>?
                </p>
                <div class="nu-callout">
                    This will immediately update Firestore <code class="nu-mono" style="font-weight: 700; color: var(--nu-navy-primary);">listings/@(_selectedListingToUnpublish.Id) → status: 'unpublished'</code>, hiding it from student buyer feeds and preventing further bidding.
                </div>
            </div>

            <div class="nu-modal-footer">
                <button type="button" class="btn-nu-outline" @onclick="() => _selectedListingToUnpublish = null">
                    Cancel
                </button>
                <button type="button" class="btn-nu-danger" style="background: var(--nu-danger); color: white; border-color: var(--nu-danger);" @onclick="ConfirmUnpublish">
                    Confirm Override & Unpublish
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string _searchKeyword = string.Empty;
    private MarketplaceListing? _selectedListingToUnpublish;

    private IEnumerable<MarketplaceListing> FilteredListings =>
        string.IsNullOrWhiteSpace(_searchKeyword)
            ? FirestoreService.ActiveListings
            : FirestoreService.ActiveListings.Where(l =>
                l.Title.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase) ||
                l.Category.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase) ||
                l.SellerName.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase) ||
                l.SellerUid.Contains(_searchKeyword, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("login");
            return;
        }

        FirestoreService.OnListingsUpdated += HandleUpdate;
        await FirestoreService.InitializeSubscriptionsAsync();
    }

    private void HandleUpdate()
    {
        InvokeAsync(StateHasChanged);
    }

    private string FormatTimeSpan(TimeSpan ts)
    {
        if (ts <= TimeSpan.Zero) return "Expired";
        if (ts.TotalHours >= 24) return $"{(int)ts.TotalDays}d {ts.Hours}h left";
        return $"{ts.Hours}h {ts.Minutes}m left";
    }

    private void PromptUnpublish(MarketplaceListing listing)
    {
        _selectedListingToUnpublish = listing;
    }

    private async Task ConfirmUnpublish()
    {
        if (_selectedListingToUnpublish == null) return;
        await FirestoreService.UnpublishListingAsync(_selectedListingToUnpublish.Id);
        _selectedListingToUnpublish = null;
    }

    private async Task TogglePin(MarketplaceListing listing)
    {
        listing.IsPinned = !listing.IsPinned;
        ToastService.ShowInfo($"Priority Pin status toggled for item #{listing.Id}", "Manual Override");
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        FirestoreService.OnListingsUpdated -= HandleUpdate;
    }
}
